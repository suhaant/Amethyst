# Agent LLM. First key found wins; force one with AGENT_PROVIDER=openrouter|gemini|claude
# Gemini through OpenRouter (~$0.005 per assessment)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.8-flash

# Gemini direct from Google (free tier: about 5 requests/min per model)
GEMINI_API_KEY=

ANTHROPIC_API_KEY=
# Only needed if your key isn't scoped to a workspace (Console > Workspaces)
ANTHROPIC_WORKSPACE_ID=
