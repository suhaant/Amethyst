# Agent LLM. First key found wins; force one with AGENT_PROVIDER=gemini|openrouter|claude
# Gemini direct from Google: Gemini 3.8 Flash, low thinking, fact-checked notes (~5 s, ~$0.005)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-pro-preview   # more careful, several times the cost
# GEMINI_THINKING=low                    # low | medium | high

# Gemini through OpenRouter (paid, ~$0.005 per assessment, no per-minute cap)
OPENROUTER_API_KEY=

ANTHROPIC_API_KEY=
# Only needed if your key isn't scoped to a workspace (Console > Workspaces)
ANTHROPIC_WORKSPACE_ID=
