# Agent LLM. First key found wins; force one with AGENT_PROVIDER=gemini|openrouter|claude
# Gemini direct from Google (free tier works; ~2 requests and ~10 s per assessment)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Gemini through OpenRouter (paid, ~$0.005 per assessment, no per-minute cap)
OPENROUTER_API_KEY=

ANTHROPIC_API_KEY=
# Only needed if your key isn't scoped to a workspace (Console > Workspaces)
ANTHROPIC_WORKSPACE_ID=
