ANTHROPIC_API_KEY=
# Only needed if your key isn't scoped to a workspace (Console > Workspaces)
ANTHROPIC_WORKSPACE_ID=

# Databricks care record (only needed for --databricks and patch_gateway.py; see databricks/README.md)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
# Optional; defaults are workspace and pulsepatch
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=
